{
  "name": "site-creator-vinext-starter",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "build:pages": "vite build --config vite.github-pages.config.ts",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "npm run build && node --test tests/rendered-html.test.mjs tests/word-garden.test.mjs tests/dinosaur-pronunciation.test.mjs tests/dinosaur-audio-submit.test.mjs tests/everyday-discovery.test.mjs tests/story-side-audio.test.mjs tests/hackers-painters-reader.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern work",
    "audio:generate": "node scripts/generate-pro-aoede-production.mjs --batch-size 10",
    "audio:verify": "node scripts/verify-pro-aoede-checkpoint.mjs",
    "audio:pace": "node scripts/normalize-aoede-pacing.mjs",
    "audio:check": "node scripts/promote-aoede-audio.mjs --check",
    "audio:promote": "node scripts/promote-aoede-audio.mjs --promote",
    "audio:new-books": "node scripts/generate-new-book-audio.mjs",
    "audio:new-books:batch": "node scripts/generate-missing-audio-batch.mjs --scope story",
    "audio:story-guide": "node scripts/generate-story-guide-audio.mjs",
    "audio:story-sides": "node scripts/generate-story-side-audio.mjs --batch",
    "audio:dinosaur-pronunciation": "node scripts/generate-dinosaur-pronunciation-audio.mjs",
    "audio:everyday-discovery": "node scripts/generate-everyday-discovery-audio.mjs",
    "words:audio": "node scripts/generate-word-audio.mjs",
    "words:audio:batch": "node scripts/generate-missing-audio-batch.mjs --scope word",
    "words:verify": "node scripts/verify-word-audio.mjs",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
